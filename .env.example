# Libya Global Reports — copy to .env if you need local overrides.
# Never put secrets in client-side code or commit a filled .env.

# Public site origin used for canonical URLs, RSS, and share links.
# Leave as localhost for development. Set this to the real HTTPS origin
# only after a hosting target is chosen.
LGR_SITE_URL=http://localhost:4321

# Optional subpath when the static host is not at the domain root
# (GitHub project Pages). Leave empty or "/" for Cloudflare/Netlify root deploys.
LGR_BASE_PATH=/

# When false, demo/sample records are excluded from the built site.
# The public RSS feed never includes demo records regardless of this flag.
# Production is false as of 14 September 2026. Set true locally only to inspect SAMPLE files.
LGR_SHOW_DEMO=false

# Optional mailto or https feedback link. Leave empty to hide contact.
# Do not point this at a form that does not exist.
LGR_CONTACT_HREF=

# Optional AI drafting (translation / summaries). Disabled by default.
# The application works fully without these variables.
# Keys must stay server-side. This is not cost-metered without provider usage data.
LGR_AI_ENABLED=false
LGR_AI_API_KEY=
LGR_AI_MONTHLY_BUDGET_USD=10
LGR_AI_RESERVE_USD=5
LGR_AI_MAX_REQUESTS_PER_DAY=20

# ReliefWeb API adapter (separate from the enabled RSS adapter).
# Requires a pre-approved appname from ReliefWeb. Leave empty to keep disabled.
LGR_RELIEFWEB_APPNAME=

# Collector identity. Must contain LibyaGlobalReports and must not spoof a browser.
# Change the contact URL if you publish a public collector.
LGR_HTTP_USER_AGENT=LibyaGlobalReports/0.1 (+https://github.com/Mohamed-Fadel-wd; metadata collector; drafts only)
LGR_HTTP_TIMEOUT_MS=15000
LGR_HTTP_MAX_RETRIES=3
LGR_HTTP_MIN_INTERVAL_MS=1500
